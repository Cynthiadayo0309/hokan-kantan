{
  "name": "hokan-kantan",
  "version": "0.2.1",
  "description": "訪看かんたん計算 - 施設内訪問看護 月額費用シミュレーター",
  "main": "dist-electron/main/main.js",
  "author": "hokan-kantan",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "concurrently -k \"npm:dev\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "capture:note": "electron scripts/capture-note-images.cjs",
    "docs:pdf": "npm run build && electron scripts/generate-demo-material.cjs",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "dist": "npm run build && electron-builder --win nsis && npm run release:manifest"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "better-sqlite3": "^12.11.1",
    "electron-store": "^10.0.0",
    "exceljs": "^4.4.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuetify": "^3.7.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14.1.4",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "jp.hokan-kantan.app",
    "productName": "訪看かんたん計算",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "resources/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/pricing",
        "to": "pricing"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "訪看かんたん計算_Setup_${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "訪看かんたん計算",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
